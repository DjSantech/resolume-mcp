{
  "name": "resolume-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP para controlar Resolume Arena desde Claude vía su REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "resolume-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "autopilot": "node dist/autopilot.js",
    "autopilot:plan": "node dist/autopilot.js --dry-run",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
